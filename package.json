{
  "name": "github-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A generic, read-only GitHub MCP connector for Claude and other remote MCP clients.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "wrangler deploy --dry-run --config wrangler.template.jsonc --outdir dist",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@octokit/auth-app": "8.3.0",
    "agents": "0.21.0",
    "hono": "4.12.27",
    "octokit": "5.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@eslint/js": "9.39.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.19.11",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "3.2.4",
    "wrangler": "4.115.0"
  }
}
